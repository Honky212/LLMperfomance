# =====================================================================
# LLMperfomance 模型配置模板
# 使用方法：复制本文件为 .env 并填写实际值（.env 已被 git 忽略，不会被提交）
# 注意：若已设置同名系统环境变量，则系统环境变量优先于本文件中的值
# =====================================================================

# ---- Dify 风格接口（scripts/ 下原有 3 个脚本使用）----
# Dify 应用基础地址（脚本会自动拼接 /v1/chat-messages）
LLM_API_URL=http://<dify-host>
# Dify 应用 API Key
API_KEY=app-xxxxxxxx

# ---- OpenAI 兼容接口 ----
# 适用于：scripts/openai_compat_baseline.py
#         scripts/openai_compat_concurrent.py
#         scripts/openai_compat_endurance_locust.py
# 兼容 DeepSeek 官方 API、vLLM、Ollama、one-api/new-api 代理等服务

# 基础 URL（openai SDK 会自动拼接 /chat/completions）
OPENAI_BASE_URL=http://<gateway-host>:3000/v1
# API Key：登录后于「令牌」页面创建
OPENAI_API_KEY=sk-xxxxxxxx
# 模型 ID：渠道中配置的模型名
MODEL_NAME=deepseek-chat
# OpenAI 兼容对话脚本的最大输出 token 数（0 = 不限制）
OPENAI_MAX_TOKENS=0

# ---- 可选：诊断用 LLM（"Run LLM Analysis" 使用的模型，与被测模型解耦）----
# 未配置时回退到上面的 OPENAI_BASE_URL / OPENAI_API_KEY / MODEL_NAME，
# 即"被测模型兼任分析师"。注意：Web 面板的配置档（Configuration Profiles）
# 只决定压测目标（注入压测脚本子进程），不影响这里的诊断模型。
# ANALYSIS_LLM_BASE_URL=http://localhost:11434/v1
# ANALYSIS_LLM_API_KEY=sk-xxxxxxxx
# ANALYSIS_LLM_MODEL=qwen3:8b

# ---- 可选：Locust 压测调优项（scripts/openai_compat_endurance_locust.py 使用）----
# 用户思考时间（秒）：0 = 收到回复立即发下一条（耐力压测），缺省 1~3 秒随机
# LOCUST_WAIT_TIME=0
# 保留最近 N 轮多轮历史（一轮=一问一答），防止长跑上下文膨胀；0 = 不限制
# LOCUST_MAX_TURNS=10
# 相邻响应数据包之间的超时秒数，超时计失败，用于发现模型挂起/崩溃
# LOCUST_TIMEOUT=300

# ---- 自定义智能体接口（scripts/custom_agent_concurrent.py，Cookie 鉴权 / 非流式）----
# 接口地址（必填：未配置且未传 --url 时脚本会报错退出）
# CUSTOM_AGENT_URL=https://<custom-agent-host>/bmserv/api/agent/unified/chat
# 单个登录态 Cookie（浏览器 F12 → Network → 该请求 → 请求头 Cookie；会过期）
# CUSTOM_AGENT_COOKIE=JSESSIONID=xxxxxxxx
# 多用户并发：Cookie 文件绝对路径，每行一个，支持 "别名<TAB>Cookie"；
# 每个模拟用户绑定一份独立登录会话，避免上下文互相污染
# CUSTOM_AGENT_COOKIE_FILE=C:\secrets\cookies.txt

# ---- 可选：TLS 校验开关（所有脚本通用）----
# 是否校验 TLS 证书（true/false，缺省 true）；仅在本地自签名环境下临时设为 false，
# 关闭时脚本会打印明显警告
# VERIFY_SSL=true

# ---- Web 面板（web/server.py）可选配置 ----
# WEB_HOST=127.0.0.1    # 缺省仅本机访问；对外/局域网暴露必须配合设置 WEB_TOKEN，
#                        # 否则所有 POST/DELETE 写操作无鉴权开放
# WEB_PORT=8686
# WEB_TOKEN=            # 设置后写操作需 Authorization: Bearer <token>（SSE 用 ?token=）